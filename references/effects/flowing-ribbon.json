{
  "schema": "dig.effect.v1",
  "revision": 1,
  "source": "dig-ui-skill/original",
  "provider": {
    "name": "shaders",
    "version": "4.0.4",
    "capabilities": [
      "webgpu"
    ]
  },
  "theme_bindings": {
    "light": {},
    "dark": {}
  },
  "mount": {
    "slot": "hero-background",
    "pointer_events": "none",
    "clip": "hidden",
    "layer": "decoration",
    "scroll": "host"
  },
  "runtime": {
    "reduced_motion": "static-fallback",
    "max_pixels": 1048576,
    "context": {
      "INFORMATION_DENSITY": 3,
      "INTERACTION_ENERGY": 4,
      "OPERATIONAL_CRITICALITY": 2
    }
  },
  "fallback": {
    "type": "css-gradient",
    "colors": [
      {
        "token": "--dig-bg"
      },
      {
        "token": "--dig-accent"
      }
    ]
  },
  "assets": [],
  "id": "flowing-ribbon",
  "name": {
    "en": "Flowing ribbon",
    "zh-CN": "流动色带"
  },
  "composition": [
    {
      "id": "ribbon",
      "type": "FlowingGradient",
      "props": {
        "colorA": {
          "token": "--dig-bg"
        },
        "colorB": {
          "token": "--dig-accent"
        },
        "colorC": {
          "token": "--dig-accent-2"
        },
        "colorD": {
          "token": "--dig-bg-soft"
        },
        "speed": 0.2,
        "distortion": 0.4,
        "seed": 12,
        "colorSpace": "oklch"
      }
    }
  ],
  "parameters": [
    {
      "id": "speed",
      "layer": "ribbon",
      "prop": "speed",
      "label": {
        "en": "Speed",
        "zh-CN": "速度"
      },
      "group": "effect",
      "control": "range",
      "default": 0.2,
      "min": 0,
      "max": 2,
      "step": 0.1
    },
    {
      "id": "distortion",
      "layer": "ribbon",
      "prop": "distortion",
      "label": {
        "en": "Distortion",
        "zh-CN": "扰动强度"
      },
      "group": "effect",
      "control": "range",
      "default": 0.4,
      "min": 0,
      "max": 2,
      "step": 0.1
    },
    {
      "id": "seed",
      "layer": "ribbon",
      "prop": "seed",
      "label": {
        "en": "Variation",
        "zh-CN": "形态变化"
      },
      "group": "effect",
      "control": "range",
      "default": 12,
      "min": 0,
      "max": 100,
      "step": 1
    }
  ]
}
