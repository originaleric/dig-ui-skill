{
  "schema": "dig.effect.v1",
  "revision": 1,
  "source": "dig-ui-skill/original",
  "provider": {
    "name": "shaders",
    "version": "4.0.4",
    "capabilities": [
      "webgpu"
    ]
  },
  "theme_bindings": {
    "light": {},
    "dark": {}
  },
  "mount": {
    "slot": "local-container",
    "pointer_events": "host",
    "clip": "hidden",
    "layer": "decoration",
    "scroll": "host"
  },
  "runtime": {
    "reduced_motion": "static-fallback",
    "max_pixels": 1048576,
    "context": {
      "INFORMATION_DENSITY": 3,
      "INTERACTION_ENERGY": 4,
      "OPERATIONAL_CRITICALITY": 2
    }
  },
  "fallback": {
    "type": "css-gradient",
    "colors": [
      {
        "token": "--dig-bg"
      },
      {
        "token": "--dig-accent"
      }
    ]
  },
  "assets": [],
  "id": "cursor-ripples",
  "name": {
    "en": "Cursor ripples",
    "zh-CN": "鼠标波纹"
  },
  "composition": [
    {
      "id": "ribbon",
      "type": "FlowingGradient",
      "props": {
        "colorA": {
          "token": "--dig-bg"
        },
        "colorB": {
          "token": "--dig-accent"
        },
        "colorC": {
          "token": "--dig-accent-2"
        },
        "colorD": {
          "token": "--dig-bg-soft"
        },
        "speed": 0.2,
        "distortion": 0.4,
        "seed": 12,
        "colorSpace": "oklch"
      }
    },
    {
      "id": "ripples",
      "type": "CursorRipples",
      "props": {
        "intensity": 4,
        "decay": 12,
        "radius": 0.3,
        "chromaticSplit": 0.1
      }
    }
  ],
  "parameters": [
    {
      "id": "intensity",
      "layer": "ripples",
      "prop": "intensity",
      "label": {
        "en": "Intensity",
        "zh-CN": "波纹强度"
      },
      "group": "effect",
      "control": "range",
      "default": 4,
      "min": 0,
      "max": 20,
      "step": 0.1
    },
    {
      "id": "radius",
      "layer": "ripples",
      "prop": "radius",
      "label": {
        "en": "Radius",
        "zh-CN": "反馈半径"
      },
      "group": "effect",
      "control": "range",
      "default": 0.3,
      "min": 0.1,
      "max": 1,
      "step": 0.1
    },
    {
      "id": "decay",
      "layer": "ripples",
      "prop": "decay",
      "label": {
        "en": "Decay",
        "zh-CN": "消退速度"
      },
      "group": "effect",
      "control": "range",
      "default": 12,
      "min": 0,
      "max": 20,
      "step": 0.1
    }
  ]
}
