{
  "schema": "dig.effect.v1",
  "revision": 1,
  "source": "dig-ui-skill/original",
  "provider": {
    "name": "shaders",
    "version": "4.0.4",
    "capabilities": [
      "webgpu"
    ]
  },
  "theme_bindings": {
    "light": {},
    "dark": {}
  },
  "mount": {
    "slot": "hero-background",
    "pointer_events": "none",
    "clip": "hidden",
    "layer": "decoration",
    "scroll": "host"
  },
  "runtime": {
    "reduced_motion": "static-fallback",
    "max_pixels": 1048576,
    "context": {
      "INFORMATION_DENSITY": 3,
      "INTERACTION_ENERGY": 4,
      "OPERATIONAL_CRITICALITY": 2
    }
  },
  "fallback": {
    "type": "css-gradient",
    "colors": [
      {
        "token": "--dig-bg"
      },
      {
        "token": "--dig-accent"
      }
    ]
  },
  "assets": [],
  "id": "soft-grain",
  "name": {
    "en": "Soft grain",
    "zh-CN": "柔和颗粒"
  },
  "composition": [
    {
      "id": "grain",
      "type": "SimplexNoise",
      "props": {
        "colorA": {
          "token": "--dig-bg"
        },
        "colorB": {
          "token": "--dig-accent-2"
        },
        "scale": 2,
        "speed": 0.1,
        "contrast": 0,
        "opacity": 0.25
      }
    }
  ],
  "parameters": [
    {
      "id": "scale",
      "layer": "grain",
      "prop": "scale",
      "label": {
        "en": "Scale",
        "zh-CN": "颗粒尺度"
      },
      "group": "effect",
      "control": "range",
      "default": 2,
      "min": -2,
      "max": 5,
      "step": 0.1
    },
    {
      "id": "contrast",
      "layer": "grain",
      "prop": "contrast",
      "label": {
        "en": "Contrast",
        "zh-CN": "对比强度"
      },
      "group": "effect",
      "control": "range",
      "default": 0,
      "min": -2,
      "max": 3,
      "step": 0.1
    }
  ]
}
