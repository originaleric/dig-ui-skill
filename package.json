{
  "name": "dig-ui-skill",
  "version": "0.1.0",
  "description": "Dig UI design system skill for Codex, Cursor, and Claude Code",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dig-ui-skill": "bin/dig-ui-skill.mjs"
  },
  "files": [
    "SKILL.md",
    "SKILL.en.md",
    "SKILL.zh-CN.md",
    "dig-ui-language.json",
    "README.md",
    "README.zh-CN.md",
    "USAGE.md",
    "INSTALL.md",
    "bin/",
    "adapters/",
    "references/",
    "!references/global-rules.local.md",
    "assets/",
    "renders/",
    "agents/",
    "sync-renders.sh",
    "sync_renders.py",
    "sync_block_renders.py",
    "sync_layout_renders.py",
    "validate-dig-catalog-preview.mjs",
    "validate-dig-block-preview.mjs",
    "validate-dig-layout-preview.mjs",
    "validate-dig-render-ops.mjs"
  ],
  "scripts": {
    "sync:layouts": "./sync-renders.sh --layouts",
    "sync:blocks": "./sync-renders.sh --blocks",
    "sync:all": "./sync-renders.sh --all",
    "validate:layouts": "node validate-dig-layout-preview.mjs renders/layouts",
    "validate:blocks": "node validate-dig-block-preview.mjs renders/blocks",
    "validate:catalogs": "node validate-dig-catalog-preview.mjs renders",
    "validate:renders": "node validate-dig-render-ops.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
