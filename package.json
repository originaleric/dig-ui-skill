{
  "name": "dig-ui-skill",
  "version": "1.1.0",
  "description": "Dig UI design system skill for Codex, Cursor, and Claude Code",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dig-ui-skill": "bin/dig-ui-skill.mjs"
  },
  "files": [
    "SKILL.md",
    "SKILL.en.md",
    "SKILL.zh-CN.md",
    "dig-ui-language.json",
    "README.md",
    "README.zh-CN.md",
    "USAGE.md",
    "USAGE.zh-CN.md",
    "INSTALL.md",
    "INSTALL.zh-CN.md",
    "bin/",
    "adapters/",
    "references/",
    "!references/global-rules.local.md",
    "assets/",
    "renders/",
    "agents/",
    "sync-renders.sh",
    "sync_renders.py",
    "validate-dig-catalog-preview.mjs",
    "validate-dig-render-ops.mjs",
    "!references/local/effects/**"
  ],
  "scripts": {
    "sync:all": "./sync-renders.sh --all",
    "validate:catalogs": "node validate-dig-catalog-preview.mjs renders",
    "validate:renders": "node validate-dig-render-ops.mjs",
    "build:effects": "node bin/build-effects.mjs && node bin/effects-cli.mjs build",
    "validate:effects": "node --test tests/effects.test.mjs",
    "test:effects:browser": "node tests/effects-browser.mjs"
  },
  "devDependencies": {
    "bootstrap-icons": "^1.11.3",
    "colorjs.io": "0.5.2",
    "esbuild": "0.25.12",
    "playwright": "^1.49.0",
    "proper-lockfile": "4.1.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "shaders": "4.0.4"
  }
}
